; obs-stream-metadata — Windows installer (T-057).
; Generated by CMake from cmake/windows-installer.nsi.in
; (PLUGIN_NAME / PLUGIN_VERSION from buildspec.json). Build with:
;   makensis /DPKG_BIN=<staging>\obs-stream-metadata\obs-plugins\64bit
;             /DPKG_DATA=<staging>\obs-stream-metadata\data\obs-plugins\obs-stream-metadata
;             /DOUTDIR=<outdir> installer/windows-installer.nsi
; Payload is exactly: the plugin DLL + locale/en-US.ini +
; tls/qschannelbackend.dll. No secrets, no dev tools, no %APPDATA% writes.

!ifndef PKG_BIN
  !error "PKG_BIN (staging obs-plugins/64bit dir) is required"
!endif
!ifndef PKG_DATA
  !error "PKG_DATA (staging plugin data dir) is required"
!endif
!ifndef OUTDIR
  !define OUTDIR "."
!endif

Name "@PLUGIN_NAME@ @PLUGIN_VERSION@"
OutFile "${OUTDIR}\@PLUGIN_NAME@-@PLUGIN_VERSION@-windows-x64.exe"
Unicode True
; NOTE: 32-bit installer stub installing the x64 payload (this NSIS
; distribution ships x86 stubs only). $PROGRAMFILES64 + SetRegView 64
; keep paths/registry correct on 64-bit Windows; "-windows-x64" names
; the payload architecture, which is what matters for OBS.
RequestExecutionLevel admin
InstallDir "$PROGRAMFILES64\obs-studio"
ShowInstDetails show

!include "LogicLib.nsh"
; NOTE: nsExec.nsh header is absent from some NSIS distributions, but
; nsExec.dll (Plugin dir) is standard: call nsExec::ExecToStack directly
; (pushes output, then return code: Pop $0 code, Pop $1 output).

Var OBS_RUNNING

; --- guards ---------------------------------------------------------------
Function CheckObsRunning
  ; tasklist ships with Windows; look for the OBS process by image name.
  nsExec::ExecToStack 'tasklist /FI "IMAGENAME eq obs64.exe" /NH /FO CSV'
  Pop $0 ; exit code, ignore
  Pop $1 ; output
  StrCpy $OBS_RUNNING "0"
  ${If} $1 != ""
    Push $1
    Push "obs64.exe"
    Call StrContains
    Pop $2
    ${If} $2 != ""
      StrCpy $OBS_RUNNING "1"
    ${EndIf}
  ${EndIf}
FunctionEnd

; StrContains helper (no external plugins required).
; In: $R4 = haystack (pushed last), $R3 = needle. Out: stack top = rest or "".
Function StrContains
  Exch $R3 ; needle
  Exch
  Exch $R4 ; haystack
  Push $R5
  Push $R6
  Push $R7
  Push $R8
  StrCpy $R8 $R3 ; keep the needle intact
  StrLen $R5 $R8 ; needle length
  StrLen $R6 $R4 ; haystack length
  StrCpy $R3 ""
  IntCmp $R5 0 strdone strdone +1
  IntCmp $R6 $R5 +1 strdone +1
  strloop:
    StrCpy $R7 $R4 $R5 0
    StrCmp $R7 $R8 strfound
    StrCpy $R4 $R4 "" 1
    IntOp $R6 $R6 - 1
    IntCmp $R6 0 strdone strdone strloop
  strfound:
    StrCpy $R3 $R4
  strdone:
    Pop $R8
    Pop $R7
    Pop $R6
    Pop $R5
    Pop $R4
    Exch $R3
FunctionEnd

Function .onInit
  SetRegView 64 ; uninstall keys go to the real 64-bit registry view
  Call CheckObsRunning
  ${If} $OBS_RUNNING == "1"
    MessageBox MB_OK|MB_ICONEXCLAMATION \
      "OBS Studio is running.$\n$\nPlease close OBS completely and run this installer again.$\nNothing was installed or modified."
    Abort
  ${EndIf}
FunctionEnd

Function .onVerifyInstDir
  ; Only accept a recognizable OBS Studio installation.
  IfFileExists "$INSTDIR\bin\64bit\obs64.exe" valid
    MessageBox MB_OK|MB_ICONSTOP \
      "No OBS Studio installation found at:$\n$INSTDIR$\n$\nExpected bin\64bit\obs64.exe there. Nothing was installed."
    Abort
  valid:
FunctionEnd

; --- install ----------------------------------------------------------------
Section "Plugin (required)" SecPlugin
  SectionIn RO
  ; Upgrade-safe: remove our own previous payload first (never OBS files).
  Delete "$INSTDIR\obs-plugins\64bit\@PLUGIN_NAME@.dll"
  RMDir /r "$INSTDIR\data\obs-plugins\@PLUGIN_NAME@"

  SetOutPath "$INSTDIR\obs-plugins\64bit"
  File "${PKG_BIN}\@PLUGIN_NAME@.dll"
  SetOutPath "$INSTDIR\data\obs-plugins\@PLUGIN_NAME@\locale"
  File "${PKG_DATA}\locale\en-US.ini"
  SetOutPath "$INSTDIR\data\obs-plugins\@PLUGIN_NAME@\tls"
  File "${PKG_DATA}\tls\qschannelbackend.dll"

  WriteUninstaller "$INSTDIR\uninstall-@PLUGIN_NAME@.exe"
  WriteRegStr HKLM \
    "Software\Microsoft\Windows\CurrentVersion\Uninstall\@PLUGIN_NAME@" \
    "DisplayName" "@PLUGIN_NAME@ (@PLUGIN_VERSION@)"
  WriteRegStr HKLM \
    "Software\Microsoft\Windows\CurrentVersion\Uninstall\@PLUGIN_NAME@" \
    "UninstallString" "$INSTDIR\uninstall-@PLUGIN_NAME@.exe"
  WriteRegStr HKLM \
    "Software\Microsoft\Windows\CurrentVersion\Uninstall\@PLUGIN_NAME@" \
    "DisplayVersion" "@PLUGIN_VERSION@"
  WriteRegStr HKLM \
    "Software\Microsoft\Windows\CurrentVersion\Uninstall\@PLUGIN_NAME@" \
    "Publisher" "horangelmillan"
SectionEnd

; --- uninstall --------------------------------------------------------------
Function un.onInit
  SetRegView 64
FunctionEnd

Section "Uninstall"
  ; Remove ONLY our payload. Never OBS files, %APPDATA%, or user data.
  Delete "$INSTDIR\obs-plugins\64bit\@PLUGIN_NAME@.dll"
  RMDir /r "$INSTDIR\data\obs-plugins\@PLUGIN_NAME@"
  Delete "$INSTDIR\uninstall-@PLUGIN_NAME@.exe"
  DeleteRegKey HKLM \
    "Software\Microsoft\Windows\CurrentVersion\Uninstall\@PLUGIN_NAME@"
SectionEnd
