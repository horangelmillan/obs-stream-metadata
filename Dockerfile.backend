# Backend obs-stream-metadata (T-055, ADR-014). Python slim, sin secretos
# en la imagen: configuración por entorno, secretos por Secret Manager /
# ficheros montados (ver docs/DEPLOYMENT.md).
FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Usuario no-root (compatible: solo necesita stdout + red).
RUN useradd --create-home --uid 10001 app
WORKDIR /srv/app

COPY backend/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/ ./backend/

# Cloud Run inyecta PORT; el backend lo respeta (config.py).
ENV PORT=8080
EXPOSE 8080

USER 10001:10001

# Health del contenedor sin curl (imagen slim): urllib stdlib.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD python -c "import os,urllib.request;urllib.request.urlopen(f\"http://127.0.0.1:{os.environ.get('PORT','8080')}/health\",timeout=4)"

# Migrations corren en el arranque (app.py); SIGTERM = shutdown graceful.
CMD ["python", "-m", "backend.app"]
